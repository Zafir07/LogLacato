flowchart LR
  subgraph CAMPO["Camada de campo"]
    PH["Sonda de pH<br/>+ HW-828"]
    DS["DS18B20<br/>temp. do LEITE<br/><i>a integrar</i>"]
    DHT["DHT22<br/>temp. e umidade do AR"]
    ESP["T-Beam V1.2 (ESP32)<br/>lê sensores · hora NTP/GPS<br/>fila offline · Wi-Fi"]
    COL["Coletor (app web)<br/>acidez Dornic · densidade<br/>litragem · aceite/recusa"]
    WEB["Painel web<br/>gestão e laticínio"]
    PH --> ESP
    DS --> ESP
    DHT --> ESP
  end

  subgraph SRV["Servidor próprio — Docker Compose"]
    subgraph EDGE["rede edge (exposta)"]
      PX["proxy · Caddy<br/>HTTPS · rotas<br/><i>(API Gateway + CloudFront)</i>"]
      MQ[("mosquitto<br/>senha + ACL por cliente<br/><i>(IoT Core + EventBridge)</i>")]
    end
    subgraph INT["rede internal (privada)"]
      API["api · FastAPI<br/>REST + WebSocket<br/><i>(ECS)</i>"]
      QL["quality · worker<br/>regras e alertas<br/><i>(Lambda)</i>"]
      NT["notifier · worker<br/>e-mail de alerta<br/><i>(SNS)</i>"]
      DB[("postgres<br/>histórico imutável<br/><i>(RDS)</i>")]
      BK["backup · pg_dump<br/><i>(backups do RDS)</i>"]
    end
  end

  ESP -- "MQTT QoS 1<br/>telemetria · status" --> MQ
  COL -- "HTTPS" --> PX
  WEB -- "HTTPS + WebSocket" --> PX
  PX --> API
  MQ -- "telemetria" --> QL
  MQ -- "telemetria · status" --> API
  QL -- "evento alerta.aberto" --> MQ
  MQ -- "alerta.aberto" --> NT
  API --> DB
  QL --> DB
  BK --> DB
  NT -- "SMTP" --> MAIL["E-mail do laticínio<br/>e da gestão"]

  classDef pend stroke-dasharray: 5 4,stroke:#b45309,color:#78350f,fill:#fffbeb
  classDef hw fill:#ecfdf5,stroke:#047857,color:#064e3b
  classDef srv fill:#eff6ff,stroke:#1d4ed8,color:#1e3a8a
  classDef ext fill:#f8fafc,stroke:#475569,color:#0f172a
  class PH,DHT,ESP hw
  class DS pend
  class PX,MQ,API,QL,NT,DB,BK srv
  class COL,WEB,MAIL ext
