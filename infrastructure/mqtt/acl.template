# Regras de acesso aos tópicos (ACL) do LogLacto.
# __BACKEND_USER__ é trocado pelo valor de MQTT_BACKEND_USER na inicialização.
#
# Cada cliente só faz o que precisa (o papel do IAM na arquitetura do relatório):
#   dispositivos  -> escrevem só nos próprios tópicos
#   api           -> lê dispositivos, serviços e eventos; publica eventos e comandos
#   svc-quality   -> lê leituras gravadas, publica alertas
#   svc-notifier  -> lê eventos de alerta
#
# O %u nas regras "pattern" é substituído pelo usuário conectado.

# ---------- Dispositivos (ESP32 e simulador): usuário = device_id ----------
pattern write smartmilk/device/%u/telemetry
pattern write smartmilk/device/%u/status
pattern write smartmilk/device/%u/alerts
# Comandos do servidor para o dispositivo (reservado para etapas futuras)
pattern read  smartmilk/device/%u/cmd

# ---------- Serviços internos: cada um publica só o próprio estado ----------
pattern write smartmilk/services/%u/status

# ---------- API ----------
user __BACKEND_USER__
topic read  smartmilk/device/+/telemetry
topic read  smartmilk/device/+/status
topic read  smartmilk/device/+/alerts
topic write smartmilk/device/+/cmd
topic write smartmilk/events/#
topic read  smartmilk/events/#
topic read  smartmilk/services/+/status
# Usado pelo healthcheck do container do broker
topic read  $SYS/broker/uptime

# ---------- Serviço de qualidade (papel da Lambda) ----------
# Recebe da api cada leitura nova já gravada (nunca duplicatas) e publica alertas.
user svc-quality
topic read  smartmilk/events/leitura.gravada
topic write smartmilk/events/alerta.aberto
topic write smartmilk/events/alerta.encerrado

# ---------- Notificador (papel do SNS) ----------
user svc-notifier
topic read  smartmilk/events/alerta.aberto
