# Copie este arquivo para .env e troque TODAS as senhas.
# O .env nunca vai para o Git (está no .gitignore).
#
# Para gerar uma senha forte:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Proxy de entrada (Caddy) ----------
# Desenvolvimento: http://localhost
# Produção: o domínio do servidor (ex.: loglacto.seudominio.com.br). O Caddy obtém o
# certificado TLS sozinho; o domínio precisa apontar para o servidor, portas 80 e 443 abertas.
SITE_ADDRESS=http://localhost
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
CORS_ORIGINS=http://localhost

# ---------- Login do painel ----------
# Segredo que assina os tokens (mínimo 32 caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-de-pelo-menos-32-caracteres
# Primeiro administrador (criado na primeira inicialização; a senha precisa de 10+ caracteres)
ADMIN_EMAIL=admin@loglacto.local
ADMIN_PASSWORD=troque-senha-do-admin
ADMIN_NAME=Administrador
# Cria o caminhão de demonstração (esp32-001) e o de teste SIMULADO (sim-001)
SEED_DEMO=true

# ---------- Regras de monitoramento ----------
QUALITY_OPEN_AFTER=2
QUALITY_CLOSE_AFTER=3
NO_DATA_MINUTES=5
INVALID_STREAK=3
# Leitura mais velha que isso (s) não aparece como "ao vivo" no painel
LIVE_WINDOW_S=60
# Cenário do simulador: demo, normal, ruptura, ph, falha, offline
SIM_SCENARIO=demo

# ---------- PostgreSQL ----------
POSTGRES_DB=loglacto
POSTGRES_USER=loglacto
POSTGRES_PASSWORD=troque-esta-senha
# Porta no seu computador (mude se já tiver outro PostgreSQL na 5432)
POSTGRES_HOST_PORT=5432

# ---------- Backup do banco ----------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Pasta do computador onde os dumps ficam (copie-a para fora do servidor)
BACKUP_HOST_DIR=./backups

# ---------- Broker MQTT: um usuário por serviço ----------
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=troque-senha-api
MQTT_QUALITY_PASSWORD=troque-senha-quality
MQTT_NOTIFIER_PASSWORD=troque-senha-notifier

# Dispositivos autorizados no broker, no formato id:senha separados por vírgula.
# O id é o usuário MQTT do dispositivo e aparece no tópico smartmilk/device/{id}/...
# A senha não pode conter vírgula. Ids começando com "svc-" são reservados.
#   esp32-001 -> T-Beam do caminhão (firmware, Etapa 5)
#   sim-001   -> simulador de hardware (dados SIMULADOS, Etapa 4)
MQTT_DEVICE_CREDENTIALS=esp32-001:troque-senha-esp32,sim-001:troque-senha-simulador

# ---------- Notificador de alertas (e-mail) ----------
# Desenvolvimento: o Mailpit do docker-compose recebe tudo; veja em http://localhost:8025
# Produção: o SMTP do seu provedor (ex.: smtp.gmail.com, porta 587, STARTTLS=true,
# com senha de app) e os e-mails reais de quem recebe os alertas.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
ALERT_EMAIL_FROM=LogLacto <alertas@loglacto.local>
ALERT_EMAIL_TO=gestor@loglacto.local
# info | atencao | critico
NOTIFY_MIN_SEVERITY=atencao

# ---------- Execução local do backend (fora do Docker) ----------
# Só é usado quando você roda "uvicorn" ou "pytest" direto no Windows.
# Dentro do Docker o docker-compose.yml monta esses valores sozinho.
DATABASE_URL=postgresql+psycopg://loglacto:troque-esta-senha@localhost:5432/loglacto
MQTT_HOST=localhost
MQTT_PORT=1883
